<?xml version="1.0"?>
<!DOCTYPE moduleset SYSTEM "moduleset.dtd">
<?xml-stylesheet type="text/xsl" href="moduleset.xsl"?>
<moduleset>

  <!-- This moduleset describes the set of modules used to bootstrap building
       the GTK stack for macOS. -->

  <repository type="git" name="git.gnome.org"
              href="https://gitlab.gnome.org/GNOME/"/>
  <repository type="git" name="gitlab.freedesktop.org"
              href="https://gitlab.freedesktop.org/"/>
  <repository type="git" name="github"
              href="https://github.com/"/>
  <repository type="git" name="github_llvm"
              href="https://github.com/llvm/"/>
  <repository type="git" name="gitlab.x.org"
              href="https://gitlab.x.org/"/>

  <!-- <repository type="cvs" name="cvs.gnome.org"
              cvsroot=":pserver:anonymous@anoncvs.gnome.org:/cvs/gnome"/> -->

  <!-- Basic requirements needed to build jhbuild and some basic modules -->
  <autotools id="gettext" autogenargs="--disable-csharp --disable-java --disable-native-java --disable-openmp --disable-libasprintf --with-libncurses-prefix=/usr"
             autogen-sh="configure">
    <branch repo="git.gnome.org" module="gettext/gettext.git" tag="0.21">
      <patch file="gettext-glib-path.patch" strip="1"/>
    </branch>
  </autotools>

  <autotools id="libffi" autogenargs="--disable-dependency-tracking">
    <branch repo="github" module="libffi/libffi.git" tag="v3.4.4"/>
  </autotools>

  <autotools id="zlib" autogen-sh="configure">
    <branch repo="github" module="madler/zlib.git" tag="v1.3"/>
  </autotools>

  <autotools id="openssl">
    <branch repo="github" module="openssl/openssl.git" tag="OpenSSL_1_1_1w"/>
  </autotools>

  <autotools id="libpng" autogenargs="--disable-dependency-tracking">
    <branch repo="github" module="glennrp/libpng.git" tag="v1.6.40"/>
  </autotools>

  <autotools id="jpeg" autogenargs="--disable-dependency-tracking">
    <branch repo="github" module="libjpeg-turbo/libjpeg-turbo.git" tag="3.0.0"/>
  </autotools>

  <autotools id="libtiff" autogenargs="--disable-dependency-tracking --disable-lzma --disable-webp --disable-zstd --disable-pixarlog --without-x">
    <branch repo="gitlab.x.org" module="libtiff/libtiff.git" tag="v4.6.0"/>
  </autotools>

  <autotools id="libxml2" autogenargs="--disable-dependency-tracking --without-python --without-lzma --without-zlib">
    <branch repo="git.gnome.org" module="libxml2.git" tag="v2.12.3">
      <patch file="libxml2-macos-iconv.patch" strip="1"/>
    </branch>
  </autotools>

  <autotools id="ncurses" autogenargs="--without-cxx --without-cxx-binding --with-curses-h --enable-widec --enable-pc-files --with-pkg-config-name=ncursesw --disable-stripping">
    <branch repo="github" module="mirror/ncurses.git" tag="v6.4-20230708"/>
  </autotools>

  <autotools id="libiconv" autogenargs="--enable-extra-encodings --disable-dependency-tracking">
    <branch repo="github" module="gnu-mirror/libiconv.git" tag="v1.17"/>
  </autotools>

  <autotools id="glib" autogenargs="--disable-dependency-tracking --with-pcre=internal --enable-dtrace=no --disable-fam --disable-selinux --disable-systemtap --disable-libelf --disable-gtk-doc --disable-man --disable-installed-tests"
             override-configure="configure">
    <branch repo="git.gnome.org" module="glib.git" tag="2.80.0"/>
  </autotools>

  <autotools id="intltool" autogenargs="--without-perl-tag-check">
    <branch repo="git.gnome.org" module="intltool.git" tag="0.51.0"/>
  </autotools>

  <autotools id="pkg-config">
    <branch repo="github" module="pkg/pkg-config.git" tag="0.29.2">
      <patch file="pkg-config-0.29.2-glib.patch" strip="1"/>
    </branch>
  </autotools>

  <autotools id="pcre">
    <branch repo="git.gnome.org" module="pcre.git" tag="8.45"/>
  </autotools>

  <metamodule id="meta-gtk-osx-bootstrap">
    <dependencies>
      <dep package="gettext"/>
      <dep package="libffi"/>
      <dep package="zlib"/>
      <dep package="openssl"/>
      <dep package="libpng"/>
      <dep package="jpeg"/>
      <dep package="libtiff"/>
      <dep package="libxml2"/>
      <dep package="ncurses"/>
      <dep package="libiconv"/>
      <dep package="glib"/>
      <dep package="intltool"/>
      <dep package="pkg-config"/>
      <dep package="pcre"/>
    </dependencies>
  </metamodule>

</moduleset>